;;; Not a .scm file: guix pull compiles, and so runs, every .scm file of
;;; the channel.
;;; Write the inputs of scripts/test-monitoring.sh into the directory given
;;; as the argument: the rule libraries with fixed parameters, and the
;;; metrics the textfile collectors produce from the recorded fixtures.

(use-modules (johnlepikhin system services monitoring)
             (johnlepikhin system services monitoring textfile)
             (johnlepikhin system services restic maintenance)
             (johnlepikhin system services guix-prebuild run)
             (guix gexp)
             (ice-9 textual-ports))

(define here (dirname (current-filename)))
(define out (cadr (command-line)))

(define (slurp file)
  (call-with-input-file (string-append here "/" file) get-string-all))

(define (spit file content)
  (call-with-output-file (string-append out "/" file)
    (lambda (port) (display content port))))

(define rules-file
  (@@ (johnlepikhin system services monitoring) alert-rule-groups-file))

(spit "rules.yml"
      (plain-file-content
       (rules-file "rules.yml"
                   (append (host-alert-rules
                            #:network-links '(("lan0" . 1000)))
                           (service-alert-rules)
                           (stack-alert-rules)
                           (network-alert-rules
                            #:uplinks '(("jet" "pppoe-out1")
                                        ("starlink" "ether2"))
                            #:router-ports '(("ether2" . 1000)))
                           (backup-alert-rules
                            #:repositories
                            (list (backup-repository
                                   (name "laptop/home")
                                   (presence
                                    "probe_success{presence=\"laptop\"}"))
                                  (backup-repository
                                   (name "server/data")))
                            #:storage-bytes 1e12)
                           (home-assistant-alert-rules
                            #:device-entities "sensor\\..*_(battery|power)"
                            #:outage "hass_input_boolean_state{entity=\"input_boolean.outage\"} == 1")
                           (update-alert-rules)
                           (prebuild-alert-rules
                            #:publish-cache-bytes 1e11)))))

(spit "shepherd.prom"
      (render-metrics
       (shepherd-metrics (herd-status-started (slurp "herd-status.txt"))
                         '("home-assistant" "zigbee2mqtt" "absent"))))

(spit "smart.prom"
      (render-metrics
       (smartctl-metrics "/dev/nvme0" (slurp "smartctl-nvme.json") 0)))

(spit "restic-freshness.prom"
      (render-metrics
       (freshness-metrics '(("laptop/home" . 1793246400)
                            ("windows/users" . #f)))))

(spit "updates.prom"
      (render-metrics
       (update-metrics '(("ghcr.io/koenkk/zigbee2mqtt" "2.14.2"
                          "2.14.2" "2.15.0")
                         ("docker.io/grafana/loki" "3.7.9" . #f))
                       1793246400)))

(spit "prebuild.prom"
      (render-metrics
       (prebuild-metrics #:steps '(("fetch" . #t) ("warm" . #f))
                         #:targets '(("channels" . #t) ("laptop-home" . #f))
                         #:durations '(("channels" . 120))
                         #:warm-missing 3
                         #:last-success 1793246400
                         #:cache-bytes 5e10)))
